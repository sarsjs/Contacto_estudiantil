[debug] [2025-12-31T20:58:54.365Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/contacto-estudiantil/rulesets {"name":"projects/contacto-estudiantil/rulesets/a3d902c7-831d-4fb9-a50f-f143fc86dee6","source":{"files":[{"content":"rules_version = '2';\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    // Users collection - control de acceso según rol\r\n    // Los usuarios pueden leer su propio perfil para verificación de rol\r\n    match /users/{userId} {\r\n      allow read: if request.auth != null && (\r\n        request.auth.uid == userId ||\r\n        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||\r\n        (\r\n          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador' &&\r\n          resource.data.role == 'estudiante'\r\n        )\r\n      );\r\n\r\n      // Directores pueden gestionar todos los perfiles; orientadores solo pueden crear/editar/borrar alumnos.\r\n      allow write: if request.auth != null &&\r\n        (\r\n          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||\r\n          (\r\n            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador' &&\r\n            (\r\n              (request.resource != null && request.resource.data.role == 'estudiante') ||\r\n              (request.resource == null && resource != null && resource.data.role == 'estudiante')\r\n            )\r\n          )\r\n        );\r\n    }\r\n\r\n    // Groups collection - read allowed for all roles, write only for directors\r\n    match /groups/{groupId} {\r\n      allow read: if request.auth != null;\r\n      allow write: if request.auth != null &&\r\n                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director';\r\n    }\r\n\r\n    // Subjects collection - read for all roles, write only for directors\r\n    match /subjects/{subjectId} {\r\n      allow read: if request.auth != null;\r\n      allow write: if request.auth != null &&\r\n                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director';\r\n    }\r\n\r\n    // Timetables collection - read allowed for all, write only for directors\r\n    match /timetables/{timetableId} {\r\n      allow read: if request.auth != null;\r\n      allow write: if request.auth != null &&\r\n                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director';\r\n    }\r\n\r\n    // Messages collection - read allowed for authenticated users, write restricted\r\n    match /messages/{messageId} {\r\n      allow read: if request.auth != null;\r\n      allow write: if request.auth != null &&\r\n                   (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||\r\n                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador' ||\r\n                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'profesor');\r\n    }\r\n\r\n    // Events collection - read for all roles, write restricted to directors and counselors\r\n    match /events/{eventId} {\r\n      allow read: if request.auth != null;\r\n      allow write: if request.auth != null &&\r\n                   (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||\r\n                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador');\r\n      allow delete: if request.auth != null &&\r\n                    (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||\r\n                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador');\r\n    }\r\n\r\n    // Attendance collection - read/write based on role\r\n    // To handle the document ID format {studentId}_{date}_{subjectId}, we need to implement\r\n    // role-based access and allow students to access their own records\r\n    match /attendance/{attendanceId} {\r\n      allow read: if request.auth != null &&\r\n                  (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||\r\n                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador' ||\r\n                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'profesor');\r\n      allow write: if request.auth != null &&\r\n                   (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||\r\n                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'profesor');\r\n    }\r\n\r\n    // Grades collection - read/write based on role\r\n    match /grades/{gradeId} {\r\n      allow read: if request.auth != null &&\r\n                  (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||\r\n                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador' ||\r\n                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'profesor');\r\n      allow write: if request.auth != null &&\r\n                   (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||\r\n                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'profesor');\r\n    }\r\n\r\n    // Activity Logs collection\r\n    match /activity_logs/{logId} {\r\n      allow create: if request.auth != null;\r\n      allow read: if request.auth != null &&\r\n                  (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director' ||\r\n                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'orientador');\r\n    }\r\n\r\n    // Default rule - restrictive for all other collections\r\n    match /{document=**} {\r\n      allow read, write: if false; // Default: no access\r\n    }\r\n  }\r\n}","name":"firestore.rules"}]},"createTime":"2025-12-31T20:58:53.054015Z","metadata":{"services":["cloud.firestore"]}}

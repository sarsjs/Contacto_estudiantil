# Clave pública de App Check (reCAPTCHA v3) obtenida en Firebase > App Check > Apps > contacto-estudiantil
# Usa tu propia Site Key generada en la consola de Firebase; no se debe versionar una clave real.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Token de depuración opcional para pruebas locales (true genera uno automático)
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=
